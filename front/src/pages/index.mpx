<template>
  <view class="app-shell" style="--status-bar-height: {{statusBarHeight}}px">
    <view wx:if="{{ currentPage === 'store' }}" class="home-screen">
      <image class="home-image" mode="aspectFill" src="{{ homeImage }}" />
      <view class="home-atmosphere"></view>
      <view class="home-brand">
        <view class="brand-wordmark">{{ brandName }}</view>
      </view>
      <view class="home-actions">
        <view class="start-order" bindtap="startOrdering">
          <text class="action-title">开始点单</text>
          <text class="action-subtitle">Start Order</text>
        </view>
        <view class="action-rule"></view>
        <view class="member-entry" bindtap="openMembership">
          <text class="action-title">我的</text>
          <text class="action-subtitle">My Account</text>
        </view>
      </view>
    </view>
    <view wx:if="{{ currentPage === 'membership' }}" class="destination-screen profile-screen">
      <scroll-view class="profile-scroll" scroll-y>
        <view class="profile-hero">
          <image class="profile-hero-image" mode="aspectFill" src="{{ homeImage }}" />
          <view class="profile-hero-shade"></view>
          <view class="profile-brand">{{ brandName }}</view>
        </view>
        <view class="profile-content">
          <view class="profile-summary">
            <view class="profile-user-row">
              <view class="profile-avatar">
                <image src="{{ userIcon }}" />
              </view>
              <view class="profile-user-copy">
                <view class="profile-user-name">会员</view>
                <view class="profile-user-caption">欢迎来到 {{ brandName }}</view>
              </view>
              <image class="profile-user-arrow" src="{{ chevronIcon }}" />
            </view>
          </view>
          <view class="profile-tools">
            <view class="profile-tool" bindtap="openMyOrders">
              <image src="{{ receiptIcon }}" /><text>我的订单</text>
            </view>
            <view class="profile-tool" bindtap="openAddressBook">
              <image src="{{ mapPinIcon }}" /><text>地址管理</text>
            </view>
            <view class="profile-tool" bindtap="callStore">
              <image src="{{ coffeeIcon }}" /><text>联系门店</text>
            </view>

            <view class="profile-tool" bindtap="openFavorites">
              <image src="{{ starIcon }}" /><text>我的收藏</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view wx:if="{{ currentPage === 'addresses' }}" class="destination-screen addresses-screen">
      <view class="addresses-header">
        <view class="addresses-back" bindtap="closeAddressBook">‹</view>
        <view class="addresses-heading">
          <text class="addresses-title">收货地址</text>
          <text class="addresses-subtitle">管理配送信息</text>
        </view>
      </view>
      <view class="addresses-body">
        <view wx:if="{{ addressesLoading && userAddresses.length === 0 }}" class="address-state">正在加载地址</view>
        <view wx:if="{{ !addressesLoading && addressesError && userAddresses.length === 0 }}" class="address-state">
          <text>地址加载失败</text>
          <view class="address-state-actions">
            <view class="address-retry" bindtap="loadAddresses">重新加载</view>
            <view class="address-retry address-add-first" bindtap="openNewAddress">＋ 新增地址</view>
          </view>
        </view>
        <view wx:if="{{ !addressesLoading && !addressesError && userAddresses.length === 0 }}" class="address-state">
          <text>还没有收货地址</text>
          <view class="address-retry address-add-first" bindtap="openNewAddress">＋ 新增地址</view>
        </view>
        <scroll-view wx:if="{{ userAddresses.length > 0 }}" class="addresses-list" scroll-y refresher-enabled="{{ true }}"
          refresher-triggered="{{ addressesRefreshing }}" bindrefresherrefresh="refreshAddresses">
          <view wx:for="{{ userAddresses }}" wx:key="id" class="address-card">
            <view class="address-card-main" bindtap="editAddress" data-id="{{ item.id }}">
              <view class="address-recipient-row">
                <text class="address-recipient">{{ item.recipient }}</text>
                <text class="address-phone">{{ item.phone }}</text>
                <text wx:if="{{ item.isDefault }}" class="address-default-label">默认</text>
              </view>
              <view class="address-location">{{ item.province }} {{ item.city }} {{ item.district }} {{ item.detail }}</view>
            </view>
            <view class="address-card-actions">
              <view wx:if="{{ !item.isDefault }}" class="address-action" bindtap="makeDefaultAddress"
                data-id="{{ item.id }}">设为默认</view>
              <view class="address-action" bindtap="editAddress" data-id="{{ item.id }}">编辑</view>
              <view class="address-action address-action-delete" bindtap="removeAddress" data-id="{{ item.id }}">删除</view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{ userAddresses.length > 0 }}" class="addresses-add-footer">
        <view class="addresses-add-button" bindtap="openNewAddress">＋ 新增地址</view>
      </view>
    </view>
    <page-container show="{{ addressFormVisible || storePickerVisible || selectedProduct }}" position="bottom"
      duration="300" overlay="{{ true }}" round="{{ true }}" close-on-slide-down="{{ true }}"
      bind:beforeleave="closeNativeSheet" bind:clickoverlay="closeNativeSheet">
      <view wx:if="{{ addressFormVisible }}" class="address-form-sheet">
        <view class="address-form-header">
          <text>{{ selectedAddressId ? '编辑地址' : '新增地址' }}</text>
          <view class="address-form-close" bindtap="closeAddressForm">×</view>
        </view>
        <scroll-view class="address-form-scroll" scroll-y>
          <view wx:if="{{ addressFormError }}" class="address-form-error">{{ addressFormError }}</view>
          <view class="address-field">
            <text class="address-field-label">收件人</text>
            <input class="address-input" value="{{ addressForm.recipient }}" placeholder="姓名" maxlength="64"
              bindinput="onAddressInput" data-field="recipient" />
          </view>
          <view class="address-field">
            <text class="address-field-label">手机号</text>
            <input class="address-input" value="{{ addressForm.phone }}" placeholder="联系电话" type="number" maxlength="24"
              bindinput="onAddressInput" data-field="phone" />
          </view>
          <view class="address-field">
            <text class="address-field-label">所在地区</text>
            <picker mode="region" value="{{ addressRegion }}" bindchange="onAddressRegionChange">
              <view class="address-region {{addressForm.province ? '' : 'address-placeholder'}}">{{ addressForm.province
                || '请选择省/市/区'}} {{ addressForm.city }} {{ addressForm.district }}</view>
            </picker>
          </view>
          <view class="address-field address-field-detail">
            <text class="address-field-label">详细地址</text>
            <textarea class="address-textarea" value="{{ addressForm.detail }}" placeholder="街道、楼栋、门牌号" maxlength="255"
              bindinput="onAddressInput" data-field="detail" />
          </view>
          <view class="address-default-row">
            <text>设为默认地址</text>
            <switch checked="{{ addressForm.isDefault }}" color="#52745c" bindchange="onAddressDefaultChange" />
          </view>
        </scroll-view>
        <view class="address-form-footer">
          <view class="address-save-button {{addressSaving ? 'address-save-disabled' : ''}}" bindtap="saveAddress">
            {{ addressSaving ? '保存中…' : '保存地址' }}</view>
        </view>
      </view>
      <view wx:elif="{{ storePickerVisible }}" class="store-picker-sheet">
        <view class="store-picker-header">
          <text>选择门店</text>
          <view class="store-picker-close" bindtap="closeStorePicker">×</view>
        </view>
        <scroll-view class="store-picker-list" scroll-y>
          <view wx:for="{{ stores }}" wx:key="storeId" class="store-option" bindtap="selectStore"
            data-id="{{ item.storeId }}">
            <view class="store-option-copy">
              <text class="store-option-name">{{ item.name }}</text>
              <text wx:if="{{ item.address }}" class="store-option-address">{{ item.address }}</text>
            </view>
            <view class="store-option-status">
              <text wx:if="{{ item.isTest }}" class="store-option-test">测试</text>
              <text wx:if="{{ item.storeId === storeId }}" class="store-option-selected">当前</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:elif="{{ selectedProduct }}" class="modal-sheet">
        <view class="modal-hero">
          <image class="modal-product-image" mode="aspectFit" src="{{ selectedProduct.image }}" />
          <view class="modal-close" bindtap="closeProduct">×</view>
        </view>
        <scroll-view class="modal-content" scroll-y>
          <view class="modal-product-heading">
            <view class="modal-product-name">{{ selectedProduct.name }}</view>
            <view class="favorite-button {{isSelectedFavorite ? 'favorite-active' : ''}}" bindtap="toggleFavorite">
              <text>{{ isSelectedFavorite ? '♥' : '♡' }}</text>
            </view>
          </view>
          <view class="modal-description">{{ selectedProduct.description }}</view>
          <view wx:for="{{ selectedProduct.options }}" wx:for-item="group" wx:for-index="groupIndex" wx:key="id"
            class="option-group">
            <view class="option-title">{{ group.title }}</view>
            <view class="option-list">
              <view wx:for="{{ group.values }}" wx:for-item="option" wx:for-index="optionIndex" wx:key="label"
                class="option-chip {{group.selectedIndex === optionIndex ? 'option-selected' : ''}}"
                bindtap="selectProductOption" data-group-index="{{ groupIndex }}" data-option-index="{{ optionIndex }}">
                {{ option.label }}{{ option.extraPrice ? ' ¥ ' + option.extraPrice : '' }}
              </view>
            </view>
          </view>
        </scroll-view>
        <view class="modal-footer">
          <view class="quantity-row">
            <view class="selected-summary">{{ selectedSummary }}</view>
            <view class="quantity-control">
              <view class="quantity-button quantity-minus" bindtap="decreaseQuantity">−</view>
              <text class="quantity-value">{{ quantity }}</text>
              <view class="quantity-button quantity-plus" bindtap="increaseQuantity">+</view>
            </view>
          </view>
          <view class="add-cart-button" bindtap="addToCart">¥ {{ selectedPrice }} 加入购物车</view>
        </view>
      </view>
    </page-container>
    <view wx:if="{{ currentPage === 'orders' }}" class="destination-screen orders-screen">
      <view class="addresses-header">
        <view class="addresses-back" catchtap="closeAddressBook">‹</view>
        <view class="addresses-heading">
          <text class="addresses-title">我的订单</text>
          <text class="addresses-subtitle">订单记录</text>
        </view>
      </view>
      <view class="orders-body">
        <scroll-view class="orders-list" scroll-y lower-threshold="120" bindscrolltolower="loadMoreMyOrders"
          refresher-enabled="{{ true }}" refresher-triggered="{{ ordersRefreshing }}"
          bindrefresherrefresh="refreshMyOrders">
          <view wx:if="{{ ordersLoading && userOrders.length === 0 }}" class="orders-state">
            <view class="orders-loading-spinner"></view>
            <text>正在加载订单</text>
          </view>
          <view wx:if="{{ !ordersLoading && ordersError && userOrders.length === 0 }}" class="orders-state">
            <text>订单加载失败</text>
            <view class="orders-retry" bindtap="loadMyOrders">重新加载</view>
          </view>
          <view wx:if="{{ !ordersLoading && !ordersError && userOrders.length === 0 }}" class="orders-state">暂无订单</view>
          <view wx:for="{{ userOrders }}" wx:key="orderNo" class="orders-card">
            <view class="orders-store-row">
              <image src="{{ mapPinIcon }}" />
              <text>{{ item.storeName }}</text>
              <text class="orders-fulfillment-label">{{ item.fulfillmentTypeText }}</text>
            </view>
            <view class="orders-card-header">
              <text class="orders-created-at">{{ item.createdAtText }}</text>
              <text
                class="orders-status {{item.status === 'paid' ? 'orders-status-paid' : 'orders-status-other'}}">{{ item.statusText }}</text>
            </view>
            <view wx:for="{{ item.items }}" wx:for-item="product" wx:key="cartItemId" class="orders-product">
              <image wx:if="{{ product.image }}" class="orders-product-image" mode="aspectFill" src="{{ product.image }}" />
              <text class="orders-product-name">{{ product.name }} ×{{ product.quantity }}</text>
              <text class="orders-product-total">¥ {{ product.lineAmountText }}</text>
            </view>
            <view class="orders-card-footer">
              <text class="orders-order-no">订单号 {{ item.orderNo }}</text>
              <text class="orders-total">合计 ¥ {{ item.totalAmountText }}</text>
            </view>
          </view>
          <view wx:if="{{ userOrders.length > 0 }}" class="orders-pagination">
            <view wx:if="{{ ordersLoadingMore }}" class="orders-pagination-loading">
              <view class="orders-loading-spinner"></view>
              <text>正在加载更多订单</text>
            </view>
            <text wx:if="{{ !ordersLoadingMore && ordersLoadMoreError }}" class="orders-pagination-retry"
              bindtap="loadMoreMyOrders">加载失败，点击重试</text>
            <text wx:if="{{ !ordersLoadingMore && !ordersLoadMoreError && ordersHasMore }}">上拉加载更多</text>
            <text wx:if="{{ !ordersLoadingMore && !ordersLoadMoreError && !ordersHasMore }}"
              class="orders-pagination-end">没有更多订单</text>
          </view>
        </scroll-view>
      </view>
    </view>
    <view wx:if="{{ currentPage === 'favorites' }}" class="destination-screen favorites-screen">
      <view class="addresses-header">
        <view class="addresses-back" bindtap="closeFavorites">‹</view>
        <view class="addresses-heading">
          <text class="addresses-title">我的收藏</text>
          <text class="addresses-subtitle">收藏的门店商品</text>
        </view>
      </view>
      <view class="favorites-body">
        <view wx:if="{{ favoritesLoading && userFavorites.length === 0 }}" class="address-state">正在加载收藏</view>
        <view wx:if="{{ !favoritesLoading && favoritesError && userFavorites.length === 0 }}" class="address-state">
          <text>收藏加载失败</text>
          <view class="address-retry" bindtap="loadFavorites">重新加载</view>
        </view>
        <view wx:if="{{ !favoritesLoading && !favoritesError && userFavorites.length === 0 }}" class="address-state">
          <text>还没有收藏商品</text>
          <view class="address-retry address-add-first" bindtap="startOrdering">去逛逛</view>
        </view>
        <scroll-view wx:if="{{ userFavorites.length > 0 }}" class="favorites-list" scroll-y>
          <view wx:for="{{ userFavorites }}" wx:key="id" class="favorite-card">
            <view class="favorite-card-main" bindtap="openFavoriteProduct" data-id="{{ item.id }}">
              <image wx:if="{{ item.image }}" mode="aspectFill" src="{{ item.image }}" />
              <view class="favorite-card-copy">
                <text class="favorite-card-name">{{ item.name }}</text>
                <text class="favorite-card-series">{{ item.seriesName }}</text>
                <text class="favorite-card-description">{{ item.description }}</text>
                <text class="favorite-card-price">¥ {{ item.price }}</text>
              </view>
            </view>
            <view class="favorite-remove" bindtap="removeFavorite" data-id="{{ item.id }}">移除</view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view wx:if="{{ currentPage === 'menu' }}" class="order-page">
      <view class="store-panel">
        <view class="store-heading">
          <view class="store-name" bindtap="openStorePicker">
            <image class="store-icon" src="{{ mapPinIcon }}" /> {{ storeDisplayName }}<text
              wx:if="{{ activeStore && activeStore.isTest }}" class="store-test-label">测试</text>
            <image class="store-arrow" src="{{ chevronIcon }}" />
          </view>
          <view class="map-button" bindtap="openStoreMap">
            <image class="map-button-icon" src="{{ mapIcon }}" /><text>地图</text>
          </view>
        </view>
        <view class="store-distance store-distance-action" bindtap="locateNearestStore">{{ storeDistance }}</view>
      </view>
      <view class="order-content">
        <scroll-view class="category-list" scroll-y>
          <view wx:for="{{ series }}" wx:key="id" class="category {{activeSeriesId === item.id ? 'category-active' : ''}}"
            bindtap="selectSeries" data-id="{{ item.id }}">
            <image class="category-icon" src="{{ item.icon }}" /><text>{{ item.name }}</text>
            <view wx:if="{{ item.badge }}" class="category-badge">{{ item.badge }}</view>
          </view>
        </scroll-view>
        <scroll-view class="menu-list" scroll-y>
          <swiper class="campaign" circular autoplay interval="4000" duration="500" indicator-dots
            indicator-color="rgba(255,255,255,.5)" indicator-active-color="#ffffff">
            <swiper-item wx:for="{{ campaignBanners }}" wx:key="title">
              <view class="campaign-slide">
                <image class="campaign-image" mode="aspectFill" src="{{ item.image }}" />
                <view class="campaign-shade"></view>
                <view class="campaign-copy"><text class="campaign-kicker">{{ brandName }}</text><text
                    class="campaign-title">{{ item.title }}</text><text class="campaign-price">{{ item.subtitle }}</text>
                </view>
              </view>
            </swiper-item>
          </swiper>
          <view class="section-title">{{ activeSeries.name }}</view>
          <view wx:for="{{ activeSeries.products }}" wx:key="id" class="product" bindtap="openProduct"
            data-id="{{ item.id }}">
            <image class="product-image" mode="aspectFill" src="{{ item.image }}" />
            <view class="product-info">
              <view class="product-name">{{ item.name }}</view>
              <view class="product-description">{{ item.description }}</view>
              <view class="product-price">¥ {{ item.price }}</view>
            </view>
          </view>
          <view class="menu-padding"></view>
        </scroll-view>
      </view>
      <view class="menu-cart-entry cart-entry" bindtap="openCart" aria-label="打开购物车">
        <image class="cart-entry-icon" src="{{ cartIcon }}" />
        <text>购物车</text>
        <view wx:if="{{ cartCount > 0 }}" class="cart-entry-badge">{{ cartCount }}</view>
      </view>
    </view>
    <view wx:if="{{ currentPage === 'cart' }}" class="cart-page" style="--status-bar-height: {{statusBarHeight}}px">
      <view class="cart-header">
        <view class="cart-back" bindtap="closeCart" aria-label="返回点单">‹</view>
        <view class="cart-heading">
          <text class="cart-title">购物车</text>
          <text class="cart-count-label">{{ cartCount }} 件商品</text>
        </view>
      </view>
      <scroll-view class="cart-scroll" scroll-y>
        <view wx:if="{{ cartLines.length === 0 }}" class="cart-empty">
          <image class="cart-empty-icon" src="{{ cartIcon }}" />
          <view class="cart-empty-title">购物车还是空的</view>
          <view class="cart-empty-action" bindtap="closeCart">去点单</view>
        </view>
        <view wx:else class="cart-items">
          <view wx:for="{{ cartLines }}" wx:key="id" class="cart-item">
            <image class="cart-product-image" mode="aspectFill" src="{{ item.image }}" />
            <view class="cart-item-main">
              <view class="cart-item-top">
                <view class="cart-item-name">{{ item.name }}</view>
                <view class="cart-remove" bindtap="removeCartItem" data-id="{{ item.id }}">删除</view>
              </view>
              <view class="cart-item-options">{{ item.options }}</view>
              <view class="cart-item-bottom">
                <view class="cart-item-price">¥ {{ item.lineTotal }}</view>
                <view class="cart-quantity-control">
                  <view class="cart-quantity-button" bindtap="changeCartQuantity" data-id="{{ item.id }}" data-delta="-1"
                    aria-label="减少数量">−</view>
                  <text class="cart-quantity-value">{{ item.quantity }}</text>
                  <view class="cart-quantity-button cart-quantity-plus" bindtap="changeCartQuantity"
                    data-id="{{ item.id }}" data-delta="1" aria-label="增加数量">+</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{ cartLines.length > 0 }}" class="cart-footer">
        <view class="cart-fulfillment-row">
          <text class="cart-fulfillment-label">用餐方式</text>
          <view class="cart-fulfillment-segment">
            <view class="cart-fulfillment-option {{fulfillmentType === 'delivery' ? 'cart-fulfillment-selected' : ''}}"
              bindtap="selectFulfillmentType" data-type="delivery">外送</view>
            <view class="cart-fulfillment-option {{fulfillmentType === 'dine_in' ? 'cart-fulfillment-selected' : ''}}"
              bindtap="selectFulfillmentType" data-type="dine_in">堂食</view>
          </view>
        </view>
        <view class="cart-footer-main">
          <view class="cart-total">
            <text class="cart-total-label">合计</text>
            <text class="cart-total-value">¥ {{ cartTotal }}</text>
          </view>
          <view class="cart-footer-actions">
            <view class="cart-continue" bindtap="closeCart">继续点单</view>
            <button class="cart-pay" loading="{{ paying }}" disabled="{{ paying }}" bindtap="payNow">立即支付</button>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{ currentPage === 'payment-success' }}" class="payment-success-page"
      style="--status-bar-height: {{statusBarHeight}}px">
      <view class="payment-success-header">
        <view class="payment-success-check">✓</view>
        <view class="payment-success-title">支付成功</view>
        <view class="payment-success-subtitle">订单已完成</view>
      </view>
      <scroll-view class="payment-success-content" scroll-y>
        <view class="payment-success-amount">¥ {{ successOrder.totalAmountText }}</view>
        <view class="payment-success-caption">实付金额</view>
        <view class="payment-success-meta">
          <view class="payment-success-meta-row"><text>订单编号</text><text
              class="payment-success-order-no">{{ successOrder.orderNo }}</text></view>
          <view class="payment-success-meta-row"><text>用餐方式</text><text>{{ successOrder.fulfillmentTypeText }}</text>
          </view>
          <view class="payment-success-meta-row"><text>支付时间</text><text>{{ successOrder.paidAtText || '已确认' }}</text>
          </view>
        </view>
        <view class="payment-success-items">
          <view class="payment-success-section-title">商品明细</view>
          <view wx:for="{{ successOrder.items }}" wx:key="cartItemId" class="payment-success-item">
            <view class="payment-success-item-main">
              <view class="payment-success-item-name">{{ item.name }}</view>
              <view wx:if="{{ item.options }}" class="payment-success-item-options">{{ item.options }}</view>
            </view>
            <view class="payment-success-item-quantity">×{{ item.quantity }}</view>
            <view class="payment-success-item-total">¥ {{ item.lineAmountText }}</view>
          </view>
        </view>
      </scroll-view>
      <view class="payment-success-footer">
        <view class="payment-success-return" bindtap="returnToMenu">继续点单</view>
      </view>
    </view>
    <view wx:if="{{ currentPage !== 'store' && currentPage !== 'cart' && currentPage !== 'payment-success' }}"
      class="bottom-nav">
      <view wx:for="{{ navigation }}" wx:key="page"
        class="nav-item {{currentPage === item.page || ((currentPage === 'orders' || currentPage === 'addresses' || currentPage === 'favorites') && item.page === 'membership') ? 'nav-active' : ''}}"
        bindtap="changePage" data-page="{{ item.page }}">
        <image class="nav-icon" src="{{ item.icon }}" />
        <text>{{ item.label }}</text>
        <text class="nav-english">{{ item.english }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { mapState, mapStores } from '@mpxjs/pinia'
import { useMenuStore } from '../store/menu'
import { createPaymentOrder, createUserAddress, deleteUserAddress, getAssetUrl, getMyPaymentOrders, getPaymentOrder, getUserAddresses, getUserFavorites, loginWithWechat, toggleUserFavorite, updateUserAddress } from '../api/menu'
import mapPinIcon from '../assets/icons/map-pin.svg'
import mapIcon from '../assets/icons/map.svg'
import chevronIcon from '../assets/icons/chevron-right.svg'
import cartIcon from '../assets/icons/shopping-bag.svg'
import houseIcon from '../assets/icons/house.svg'
import receiptIcon from '../assets/icons/receipt-text.svg'
import userIcon from '../assets/icons/user-round.svg'
import starIcon from '../assets/icons/star.svg'
import coffeeIcon from '../assets/icons/coffee.svg'

const bannerImage = getAssetUrl('coffee/banner.jpg')
const roseLatteImage = getAssetUrl('coffee/rose-latte.jpg')
const butterLatteImage = getAssetUrl('coffee/butter-latte.jpg')
const homeImage = getAssetUrl('coffee/store-interior.jpg')

function formatMoney(amountFen) {
  return (Number(amountFen || 0) / 100).toFixed(2)
}

function formatPaidAt(value) {
  if (!value) return ''
  const date = new Date(value)
  if (Number.isNaN(date.getTime())) return ''
  const pad = part => String(part).padStart(2, '0')
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`
}

function formatOrderStatus(status) {
  const labels = {
    pending: '待支付',
    paid: '已支付',
    closed: '已关闭',
    refunded: '已退款'
  }
  return labels[status] || '处理中'
}

function formatFulfillmentType(type) {
  return type === 'delivery' ? '外送' : '堂食'
}

function calculateDistanceKm(latitude, longitude, storeLatitude, storeLongitude) {
  const radians = degrees => degrees * Math.PI / 180
  const latitudeDelta = radians(storeLatitude - latitude)
  const longitudeDelta = radians(storeLongitude - longitude)
  const haversine = Math.sin(latitudeDelta / 2) ** 2 +
    Math.cos(radians(latitude)) * Math.cos(radians(storeLatitude)) *
    Math.sin(longitudeDelta / 2) ** 2

  return 6371 * 2 * Math.atan2(Math.sqrt(haversine), Math.sqrt(1 - haversine))
}

createPage({
  data: {
    currentPage: 'store',
    paying: false,
    fulfillmentType: 'dine_in',
    storeReady: false,
    pendingStartOrdering: false,
    successOrder: { items: [] },
    ordersLoading: false,
    ordersRefreshing: false,
    ordersLoadingMore: false,
    ordersError: false,
    ordersLoadMoreError: false,
    ordersHasMore: false,
    ordersCursor: null,
    userOrders: [],
    userAddresses: [],
    userFavorites: [],
    favoriteProductIds: [],
    favoritesStoreLoaded: '',
    favoritesLoading: false,
    favoritesError: false,
    favoriteSaving: false,
    addressesLoading: false,
    addressesRefreshing: false,
    addressesError: false,
    addressFormVisible: false,
    addressSaving: false,
    addressFormError: '',
    addressReturnPage: '',
    selectedAddressId: 0,
    addressRegion: [],
    addressForm: {
      recipient: '',
      phone: '',
      province: '',
      city: '',
      district: '',
      detail: '',
      isDefault: false
    },
    storeDisplayName: '',
    storePickerVisible: false,
    statusBarHeight: 20,
    storeDistance: '点击定位查看附近门店',
    homeImage,
    mapPinIcon,
    mapIcon,
    chevronIcon,
    cartIcon,
    userIcon,
    receiptIcon,
    starIcon,
    coffeeIcon,
    campaignBanners: [
      { title: '秋日拿铁', subtitle: '香浓限定 ¥25', image: bannerImage },
      { title: '玫瑰米酿', subtitle: '季节新品 ¥20', image: roseLatteImage },
      { title: '黄油 SOE', subtitle: '醇香限定 ¥20', image: butterLatteImage }
    ],
    navigation: [
      { page: 'store', label: '首页', english: 'Home', icon: houseIcon },
      { page: 'menu', label: '开始点单', english: 'Start Order', icon: receiptIcon },
      { page: 'membership', label: '我的', english: 'My', icon: userIcon }
    ]
  },
  computed: {
    ...mapStores(useMenuStore),
    ...mapState(useMenuStore, ['brandName', 'series', 'activeSeries', 'activeSeriesId', 'selectedProduct', 'selectedPrice', 'selectedSummary', 'quantity', 'cartLines', 'cartCount', 'cartTotal', 'activeStore', 'stores', 'storeId']),
    isSelectedFavorite() {
      return Boolean(this.menuStore.selectedProduct && this.favoriteProductIds.indexOf(this.menuStore.selectedProduct.id) !== -1)
    }
  },
  onLoad() {
    const systemInfo = mpx.getSystemInfoSync()
    this.statusBarHeight = systemInfo.statusBarHeight || 20
    this.loginOnStartup()
    mpx.setNavigationBarColor({
      frontColor: '#000000',
      backgroundColor: '#ffffff'
    })
    this.initializeStore()
  },
  onShow() {
    if (this.currentPage === 'menu' && this.storeReady) this.updateStoreDistance()
  },
  methods: {
    async initializeStore() {
      try {
        const store = await this.menuStore.loadStores()
        this.storeDisplayName = store.name
        await this.menuStore.loadMenu()
        this.storeReady = true
        if (this.pendingStartOrdering) {
          this.pendingStartOrdering = false
          this.startOrdering()
        }
      } catch (error) {
        this.pendingStartOrdering = false
        mpx.showToast({ title: '门店或菜单加载失败，请检查网络', icon: 'none' })
      }
    },
    async loginOnStartup() {
      try {
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        await loginWithWechat(this.menuStore.merchantId, login.code)
      } catch (error) {
        mpx.showToast({ title: '登录暂不可用，支付时将重试', icon: 'none' })
      }
    },
    startOrdering() {
      if (!this.storeReady) {
        this.pendingStartOrdering = true
        mpx.showToast({ title: '正在定位并进入最近门店…', icon: 'loading', duration: 10000 })
        return
      }
      this.currentPage = 'menu'
      mpx.showToast({ title: '正在定位并进入最近门店…', icon: 'loading', duration: 10000 })
      this.locateNearestStore(true)
    },
    async locateNearestStore(showProgress = false) {
      if (!this.storeReady) return
      this.storeDistance = '正在定位附近门店…'
      try {
        const location = await mpx.getLocation({ type: 'gcj02' })
        const store = await this.menuStore.selectNearestStore(location)
        if (store) this.storeDisplayName = store.name
        this.updateStoreDistance(location)
        if (showProgress) mpx.hideToast()
      } catch (error) {
        this.storeDistance = '开启定位后查看门店距离'
        if (showProgress) {
          mpx.hideToast()
          mpx.showToast({ title: '定位失败，已进入当前门店', icon: 'none' })
        }
      }
    },
    openStorePicker() {
      this.storePickerVisible = true
    },
    closeStorePicker() {
      this.storePickerVisible = false
    },
    closeNativeSheet() {
      this.storePickerVisible = false
      this.addressFormVisible = false
      this.menuStore.closeProduct()
    },
    async selectStore(event) {
      const storeId = event.currentTarget.dataset.id
      if (storeId === this.menuStore.storeId) {
        this.closeStorePicker()
        return
      }
      try {
        await this.menuStore.selectStore(storeId)
        this.storeDisplayName = this.menuStore.activeStore.name
        this.closeStorePicker()
        await this.updateSelectedStoreDistance()
      } catch (error) {
        mpx.showToast({ title: '切换门店失败，请重试', icon: 'none' })
      }
    },
    openMembership() {
      this.currentPage = 'membership'
    },
    openFavorites() {
      this.currentPage = 'favorites'
      this.loadFavorites()
    },
    closeFavorites() {
      this.currentPage = 'membership'
    },
    async loadFavorites() {
      if (this.favoritesLoading) return
      this.favoritesLoading = true
      this.favoritesError = false
      try {
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        const result = await getUserFavorites(this.menuStore.merchantId, this.menuStore.storeId, login.code)
        const favorites = (result.favorites || []).map(entry => ({
          ...entry.product,
          seriesId: entry.seriesId,
          seriesName: entry.seriesName,
          image: getAssetUrl(entry.product.image)
        }))
        this.userFavorites = favorites
        this.favoriteProductIds = favorites.map(product => product.id)
        this.favoritesStoreLoaded = this.menuStore.storeId
      } catch (error) {
        this.favoritesError = true
      } finally {
        this.favoritesLoading = false
      }
    },
    async toggleFavorite() {
      if (this.favoriteSaving || !this.menuStore.selectedProduct) return
      const product = this.menuStore.selectedProduct
      this.favoriteSaving = true
      try {
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        const result = await toggleUserFavorite(this.menuStore.merchantId, this.menuStore.storeId, product.id, login.code)
        if (result.isFavorite) {
          if (this.favoriteProductIds.indexOf(product.id) === -1) {
            const series = this.menuStore.series.find(item => item.products.some(candidate => candidate.id === product.id))
            this.favoriteProductIds = this.favoriteProductIds.concat(product.id)
            this.userFavorites = this.userFavorites.concat({
              ...product,
              image: getAssetUrl(product.image),
              seriesName: series ? series.name : ''
            })
          }
          mpx.showToast({ title: '已收藏', icon: 'success' })
        } else {
          this.favoriteProductIds = this.favoriteProductIds.filter(id => id !== product.id)
          this.userFavorites = this.userFavorites.filter(item => item.id !== product.id)
          mpx.showToast({ title: '已取消收藏', icon: 'none' })
        }
      } catch (error) {
        mpx.showToast({ title: '收藏操作失败，请重试', icon: 'none' })
      } finally {
        this.favoriteSaving = false
      }
    },
    removeFavorite(event) {
      const productId = event.currentTarget.dataset.id
      if (this.favoriteSaving) return
      this.favoriteSaving = true
      mpx.login().then(login => {
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        return toggleUserFavorite(this.menuStore.merchantId, this.menuStore.storeId, productId, login.code)
      }).then(result => {
        if (result.isFavorite) return
        this.favoriteProductIds = this.favoriteProductIds.filter(id => id !== productId)
        this.userFavorites = this.userFavorites.filter(item => item.id !== productId)
      }).catch(() => {
        mpx.showToast({ title: '移除收藏失败，请重试', icon: 'none' })
      }).finally(() => {
        this.favoriteSaving = false
      })
    },
    openFavoriteProduct(event) {
      const product = this.userFavorites.find(item => item.id === event.currentTarget.dataset.id)
      if (!product) return
      this.menuStore.selectSeries(product.seriesId)
      this.menuStore.openProduct(product.id)
      this.currentPage = 'menu'
    },
    openAddressBook() {
      this.addressReturnPage = ''
      this.currentPage = 'addresses'
      this.loadAddresses()
    },
    closeAddressBook() {
      this.closeNativeSheet()
      this.addressReturnPage = ''
      this.currentPage = 'membership'
    },
    async loadAddresses() {
      if (this.addressesLoading) {
        this.addressesRefreshing = false
        return
      }
      this.addressesLoading = true
      this.addressesError = false
      try {
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        const result = await getUserAddresses(this.menuStore.merchantId, login.code)
        this.userAddresses = result.addresses || []
      } catch (error) {
        this.addressesError = true
      } finally {
        this.addressesLoading = false
        this.addressesRefreshing = false
      }
    },
    refreshAddresses() {
      this.addressesRefreshing = true
      this.loadAddresses()
    },
    openNewAddress() {
      this.selectedAddressId = 0
      this.addressFormError = ''
      this.addressRegion = []
      this.addressForm = {
        recipient: '',
        phone: '',
        province: '',
        city: '',
        district: '',
        detail: '',
        isDefault: this.userAddresses.length === 0
      }
      this.addressFormVisible = true
    },
    editAddress(event) {
      const address = this.userAddresses.find(item => item.id === Number(event.currentTarget.dataset.id))
      if (!address) return
      this.selectedAddressId = address.id
      this.addressFormError = ''
      this.addressRegion = [address.province, address.city, address.district]
      this.addressForm = {
        recipient: address.recipient,
        phone: address.phone,
        province: address.province,
        city: address.city,
        district: address.district,
        detail: address.detail,
        isDefault: address.isDefault
      }
      this.addressFormVisible = true
    },
    closeAddressForm() {
      this.addressFormVisible = false
      this.addressFormError = ''
    },
    onAddressInput(event) {
      const field = event.currentTarget.dataset.field
      this.addressForm = { ...this.addressForm, [field]: event.detail.value }
      this.addressFormError = ''
    },
    onAddressRegionChange(event) {
      const [province = '', city = '', district = ''] = event.detail.value || []
      this.addressRegion = event.detail.value || []
      this.addressForm = { ...this.addressForm, province, city, district }
      this.addressFormError = ''
    },
    onAddressDefaultChange(event) {
      this.addressForm = { ...this.addressForm, isDefault: event.detail.value }
    },
    async saveAddress() {
      if (this.addressSaving) return
      const address = {
        ...this.addressForm,
        recipient: this.addressForm.recipient.trim(),
        phone: this.addressForm.phone.trim(),
        province: this.addressForm.province.trim(),
        city: this.addressForm.city.trim(),
        district: this.addressForm.district.trim(),
        detail: this.addressForm.detail.trim()
      }
      const phoneDigits = (address.phone.match(/[0-9]/g) || []).length
      let validationMessage = ''
      if (!address.recipient) {
        validationMessage = '请填写收件人姓名'
      } else if (Array.from(address.recipient).length > 64) {
        validationMessage = '收件人姓名不能超过64个字符'
      } else if (!/^[0-9+() -]{6,24}$/.test(address.phone) || phoneDigits < 6) {
        validationMessage = '请输入有效联系电话（至少6位数字）'
      } else if (!address.province || !address.city || !address.district) {
        validationMessage = '请选择完整的省、市、区'
      } else if (!address.detail) {
        validationMessage = '请填写街道、楼栋和门牌号'
      } else if (Array.from(address.detail).length > 255) {
        validationMessage = '详细地址不能超过255个字符'
      }
      if (validationMessage) {
        this.addressFormError = validationMessage
        return
      }
      this.addressFormError = ''
      this.addressSaving = true
      try {
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        if (this.selectedAddressId) {
          await updateUserAddress(this.menuStore.merchantId, this.selectedAddressId, login.code, address)
        } else {
          await createUserAddress(this.menuStore.merchantId, login.code, address)
        }
        this.addressFormVisible = false
        await this.loadAddresses()
        if (this.addressReturnPage) {
          this.currentPage = this.addressReturnPage
          this.addressReturnPage = ''
        }
        mpx.showToast({ title: '地址已保存', icon: 'success' })
      } catch (error) {
        const message = error && error.message
        const title = message === 'invalid address fields'
          ? '请检查手机号、所在地区和详细地址'
          : '地址保存失败，请重试'
        this.addressFormError = title
      } finally {
        this.addressSaving = false
      }
    },
    async makeDefaultAddress(event) {
      const address = this.userAddresses.find(item => item.id === Number(event.currentTarget.dataset.id))
      if (!address) return
      try {
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        await updateUserAddress(this.menuStore.merchantId, address.id, login.code, { ...address, isDefault: true })
        await this.loadAddresses()
      } catch (error) {
        mpx.showToast({ title: '默认地址设置失败，请重试', icon: 'none' })
      }
    },
    removeAddress(event) {
      const addressId = Number(event.currentTarget.dataset.id)
      mpx.showModal({
        title: '删除地址',
        content: '确认删除这条收货地址吗？',
        success: result => {
          if (result.confirm) this.deleteAddressById(addressId)
        }
      })
    },
    async deleteAddressById(addressId) {
      try {
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('WeChat login code is missing')
        await deleteUserAddress(this.menuStore.merchantId, addressId, login.code)
        await this.loadAddresses()
        mpx.showToast({ title: '地址已删除', icon: 'success' })
      } catch (error) {
        mpx.showToast({ title: '地址删除失败，请重试', icon: 'none' })
      }
    },
    openMyOrders() {
      this.currentPage = 'orders'
      this.loadMyOrders()
    },
    async fetchMyOrders(cursor) {
      const login = await mpx.login()
      if (!login || !login.code) throw new Error('WeChat login code is missing')
      const result = await getMyPaymentOrders(this.menuStore.merchantId, login.code, cursor)
      const productImages = new Map()
      this.menuStore.series.forEach(series => {
        series.products.forEach(product => productImages.set(product.id, product.image))
      })
      return {
        orders: (result.orders || []).map(order => ({
          ...order,
          storeName: order.storeName || this.storeDisplayName,
          fulfillmentTypeText: formatFulfillmentType(order.fulfillmentType),
          statusText: formatOrderStatus(order.status),
          totalAmountText: formatMoney(order.totalAmount),
          createdAtText: formatPaidAt(order.paidAt || order.createdAt),
          items: (order.items || []).map(item => ({
            ...item,
            image: productImages.get(item.productId) || item.image || '',
            lineAmountText: formatMoney(item.lineAmount)
          }))
        })),
        hasMore: Boolean(result.hasMore),
        nextCursor: result.nextCursor || null
      }
    },
    async loadMyOrders() {
      if (this.ordersLoading || this.ordersLoadingMore) {
        this.ordersRefreshing = false
        return
      }
      this.ordersLoading = true
      this.ordersError = false
      this.ordersLoadMoreError = false
      this.ordersHasMore = false
      this.ordersCursor = null
      this.userOrders = []
      try {
        const page = await this.fetchMyOrders(null)
        this.userOrders = page.orders
        this.ordersCursor = page.nextCursor
        this.ordersHasMore = page.hasMore && Boolean(page.nextCursor)
      } catch (error) {
        this.ordersError = true
      } finally {
        this.ordersLoading = false
        this.ordersRefreshing = false
      }
    },
    async loadMoreMyOrders() {
      if (this.ordersLoading || this.ordersLoadingMore || !this.ordersHasMore || !this.ordersCursor) return
      this.ordersLoadingMore = true
      this.ordersLoadMoreError = false
      try {
        const page = await this.fetchMyOrders(this.ordersCursor)
        this.userOrders = this.userOrders.concat(page.orders)
        this.ordersCursor = page.nextCursor
        this.ordersHasMore = page.hasMore && Boolean(page.nextCursor)
      } catch (error) {
        this.ordersLoadMoreError = true
      } finally {
        this.ordersLoadingMore = false
      }
    },
    refreshMyOrders() {
      this.ordersRefreshing = true
      this.loadMyOrders()
    },
    openCart() {
      this.currentPage = 'cart'
    },
    closeCart() {
      this.currentPage = 'menu'
    },
    returnToMenu() {
      this.currentPage = 'menu'
    },
    changePage(event) {
      this.currentPage = event.currentTarget.dataset.page
    },
    selectSeries(event) {
      this.menuStore.selectSeries(event.currentTarget.dataset.id)
    },
    openProduct(event) {
      this.menuStore.openProduct(event.currentTarget.dataset.id)
      if (this.favoritesStoreLoaded !== this.menuStore.storeId) this.loadFavorites()
    },
    closeProduct() {
      this.menuStore.closeProduct()
    },
    selectProductOption(event) {
      this.menuStore.selectOption({
        groupIndex: Number(event.currentTarget.dataset.groupIndex),
        optionIndex: Number(event.currentTarget.dataset.optionIndex)
      })
    },
    decreaseQuantity() {
      this.menuStore.changeQuantity(-1)
    },
    increaseQuantity() {
      this.menuStore.changeQuantity(1)
    },
    addToCart() {
      this.menuStore.addToCart().then(() => {
        mpx.showToast({ title: '已加入购物车', icon: 'success' })
      }).catch(error => {
        mpx.showToast({ title: error.message || '添加失败，请重试', icon: 'none' })
      })
    },
    changeCartQuantity(event) {
      const item = this.menuStore.cartItems.find(entry => entry.id === Number(event.currentTarget.dataset.id))
      if (!item) return
      const quantity = item.quantity + Number(event.currentTarget.dataset.delta)
      if (quantity < 1) return
      this.menuStore.setCartItemQuantity(item.id, quantity).catch(error => {
        mpx.showToast({ title: error.message || '数量更新失败', icon: 'none' })
      })
    },
    removeCartItem(event) {
      this.menuStore.removeCartItem(Number(event.currentTarget.dataset.id)).catch(error => {
        mpx.showToast({ title: error.message || '移除失败，请重试', icon: 'none' })
      })
    },
    selectFulfillmentType(event) {
      this.fulfillmentType = event.currentTarget.dataset.type
    },
    async payNow() {
      if (this.paying) return
      if (this.menuStore.activeStore && this.menuStore.activeStore.isTest) {
        mpx.showToast({ title: '演示门店不能支付', icon: 'none' })
        return
      }
      this.paying = true
      try {
        if (this.fulfillmentType === 'delivery') {
          const addressLogin = await mpx.login()
          if (!addressLogin || !addressLogin.code) throw new Error('微信登录失败，请重试')
          const addressResult = await getUserAddresses(this.menuStore.merchantId, addressLogin.code)
          this.userAddresses = addressResult.addresses || []
          if (this.userAddresses.length === 0) {
            mpx.showModal({
              title: '需要收货地址',
              content: '外送订单需要收货地址，请先添加地址再继续支付。',
              confirmText: '去添加',
              cancelText: '暂不',
              success: result => {
                if (!result.confirm) return
                this.addressReturnPage = 'cart'
                this.currentPage = 'addresses'
              }
            })
            return
          }
        }
        const login = await mpx.login()
        if (!login || !login.code) throw new Error('微信登录失败，请重试')
        const order = await createPaymentOrder(this.menuStore.merchantId, this.menuStore.cartId, login.code, this.menuStore.storeId, this.fulfillmentType)
        await mpx.requestPayment(order.payment)

        let status = 'pending'
        let paidOrder = null
        for (let attempt = 0; attempt < 8; attempt += 1) {
          try {
            const result = await getPaymentOrder(this.menuStore.merchantId, this.menuStore.cartId, order.orderNo, this.menuStore.storeId)
            status = result.status
            if (status === 'paid') paidOrder = result
            if (status !== 'pending') break
          } catch (error) {
            break
          }
          await new Promise(resolve => setTimeout(resolve, 1000))
        }

        if (status === 'paid' && paidOrder) {
          this.successOrder = {
            ...paidOrder,
            totalAmountText: formatMoney(paidOrder.totalAmount),
            paidAtText: formatPaidAt(paidOrder.paidAt),
            fulfillmentTypeText: formatFulfillmentType(paidOrder.fulfillmentType),
            items: (paidOrder.items || []).map(item => ({
              ...item,
              lineAmountText: formatMoney(item.lineAmount)
            }))
          }
          this.currentPage = 'payment-success'
          try {
            await this.menuStore.refreshCart()
          } catch (error) {
            mpx.showToast({ title: '支付成功，购物车刷新失败', icon: 'none' })
          }
        } else {
          mpx.showToast({ title: '支付已提交，结果确认中', icon: 'none' })
        }
      } catch (error) {
        const message = error && (error.message || error.errMsg) || ''
        let title = message || '发起支付失败，请重试'
        if (message.toLowerCase().includes('cancel')) {
          title = '已取消支付'
        } else if (message.toLowerCase().includes('not configured')) {
          title = '商户暂未开通微信支付'
        } else if (message === 'delivery requires a saved address') {
          title = '外送订单需要先添加收货地址'
          this.addressReturnPage = 'cart'
          this.currentPage = 'addresses'
          this.loadAddresses()
        }
        mpx.showToast({
          title,
          icon: 'none'
        })
      } finally {
        this.paying = false
      }
    },
    updateStoreDistance(location = null) {
      const store = this.menuStore.activeStore
      if (!store || !store.latitude || !store.longitude) {
        this.storeDistance = '门店位置暂不可用'
        return
      }
      if (!location) {
        this.storeDistance = '点击定位查看附近门店'
        return
      }
      const updateDistance = currentLocation => {
        const distance = calculateDistanceKm(currentLocation.latitude, currentLocation.longitude, store.latitude, store.longitude)
        this.storeDistance = `门店距离您约${distance.toFixed(1)}km`
      }
      updateDistance(location)
    },
    async updateSelectedStoreDistance() {
      const store = this.menuStore.activeStore
      if (!store || !store.latitude || !store.longitude) {
        this.updateStoreDistance()
        return
      }
      this.storeDistance = '正在获取门店距离…'
      try {
        const location = await mpx.getLocation({ type: 'gcj02' })
        this.updateStoreDistance(location)
      } catch (error) {
        this.storeDistance = '开启定位后查看门店距离'
      }
    },
    openStoreMap() {
      const store = this.menuStore.activeStore
      if (!store || !store.latitude || !store.longitude) {
        mpx.showToast({ title: '门店位置暂不可用', icon: 'none' })
        return
      }
      mpx.openLocation({
        latitude: store.latitude,
        longitude: store.longitude,
        name: store.name,
        address: store.address
      }).catch(() => {
        mpx.showToast({ title: '暂时无法打开地图', icon: 'none' })
      })
    },
    callStore() {
      const phone = this.menuStore.activeStore && this.menuStore.activeStore.phone
      if (!phone) {
        mpx.showToast({ title: '该门店暂未配置联系电话', icon: 'none' })
        return
      }
      mpx.makePhoneCall({ phoneNumber: phone }).catch(() => {
        mpx.showToast({ title: '暂时无法拨打门店电话', icon: 'none' })
      })
    }
  }
})
</script>

